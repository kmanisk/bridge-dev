{
  "name": "bridge-dev",
  "version": "2.0.0",
  "description": "BridgeDev: self-hosted MCP policy gateway with scoped development tools and signed operator approvals",
  "repository": {
    "type": "git",
    "url": "https://github.com/kmanisk/bridge-dev.git"
  },
  "homepage": "https://github.com/kmanisk/bridge-dev#readme",
  "bugs": {
    "url": "https://github.com/kmanisk/bridge-dev/issues"
  },
  "author": "kmanisk (based on MIT-licensed chatgpt-local-coder by hoangcoderr)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bridge-dev": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node scripts/isolated-tests.mjs scripts/test-patch.mjs scripts/test-tools.mjs scripts/test-checkpoints.mjs scripts/test-mcp-upstream.mjs scripts/test-mcp-oauth.mjs scripts/test-activity-log.mjs scripts/test-project-memory.mjs scripts/test-tool-profile.mjs scripts/test-shell-persist.mjs scripts/test-phase1-safe-edit.mjs scripts/test-phase2-chezmoi.mjs scripts/test-system-enhancements.mjs scripts/test-policy-gateway.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:integration": "tsc && node scripts/test-mcp-bridge-integration.mjs",
    "test:policy": "tsc && node scripts/isolated-tests.mjs scripts/test-policy-gateway.mjs scripts/test-policy-upstream-readonly.mjs",
    "verify-audit": "node scripts/verify-audit.mjs",
    "init-claude-md": "node scripts/init-claude-md.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "test:cli": "tsc && node scripts/isolated-tests.mjs scripts/test-bridge-dev-cli.mjs",
    "test:portable": "tsc && node scripts/isolated-tests.mjs scripts/test-portable-runtime.mjs",
    "test:portable:server": "node scripts/isolated-tests.mjs scripts/test-portable-server.mjs"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "coding-agent",
    "model-context-protocol",
    "local-development",
    "filesystem",
    "git",
    "apply-patch",
    "developer-mode",
    "openai-tunnel"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
