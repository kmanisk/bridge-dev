# BridgeDev development example. Not a deployable production service.env.
# Production requires independently installed root-owned policy, key, and audit files.
# Generate independent high-entropy tokens; never commit real values.
HOST=127.0.0.1
PORT=3000
ADMIN_PORT=3001
MCP_TOKEN=REPLACE_WITH_GENERATED_RANDOM_MCP_TOKEN
ADMIN_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_ADMIN_TOKEN

# Local disposable development workspace. Configure approved roots explicitly.
WORKSPACE_PATH=/tmp/bridge-dev-workspace
CHATGPT_TOOL_PROFILE=slim
SECURITY_MODE=managed
SHELL_TIMEOUT=120
CHATGPT_AUTO_APPROVE=false

# Compatibility environment keys remain supported for existing installations.
# Use the root-owned policy gateway and signed operator workflow in production.
