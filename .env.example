# Portable BridgeDev: runs in the foreground on localhost, no root service required.
# Copy to .env and REPLACE these placeholders privately before starting.
HOST=127.0.0.1
PORT=3000
ADMIN_PORT=3001
MCP_TOKEN=REPLACE_WITH_64_HEX_CHAR_RANDOM_TOKEN
ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_TOKEN
WORKSPACE_PATH=.
BRIDGEDEV_RUNTIME_MODE=portable
CHATGPT_TOOL_PROFILE=slim
CHECKPOINT_ENABLED=false

# Optional extensions (in WORKSPACE_PATH):
# .bridge-dev/extensions.json  Markdown, links and skills
# .bridge-dev/mcp.json         Upstream MCP providers, disabled by default
# Managed Linux installations use a separate operator-owned POLICYGATE_POLICY_FILE.
